{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "gauge-local/edition",
    "name": "Gauge",
    "sourceRepository": "https://github.com/just-every/run-gauge",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "gauge-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile",
      "build": "pnpm run build",
      "verify": "pnpm run source:check && pnpm run typecheck && pnpm run test:runtime && pnpm run test:gauge && pnpm run check:deployment-spec",
      "artifact": "pnpm run delivery:artifact",
      "recovery": "Follow OPERATIONS.md: pause writes and scheduled work; retain source, private settings and an export; restore into fresh empty resources with unchanged migration names and bytes; establish a fresh owner and verify records, attachments and re-export before routing traffic."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "OPERATIONS.md"
      ],
      "testPatterns": [
        "tests/*.mjs"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@ff70d729948753ffdcceeca94aad063af2dcd979",
    "artifactFile": "gauge-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_LOCAL",
        "AUTH_ORIGIN",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "IDENTITY_PROVIDER",
        "OWNER_EMAIL",
        "APP_NAME",
        "PRIMARY_COLOR"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "INSTALLATION_KEY",
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [
        "INSTALLATION_KEY_PREVIOUS",
        "MAIL_API_KEY"
      ],
      "migrationPrefix": "",
      "healthPath": "/health",
      "recovery": "Follow OPERATIONS.md: pause writes and scheduled work; retain source, private settings and an export; restore into fresh empty resources with unchanged migration names and bytes; establish a fresh owner and verify records, attachments and re-export before routing traffic.",
      "providerEffects": [
        "outbound-mail"
      ],
      "surfaces": {
        "app": {
          "path": "/signin",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      },
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      }
    }
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "gauge-local/edition"
  }
}
