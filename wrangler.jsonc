{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "professional-services-gauge",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gauge",
      "database_id": "local-gauge-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "vars": {
    "AUTH_LOCAL": "false",
    "AUTH_ORIGIN": "",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": "",
    "IDENTITY_PROVIDER": "",
    "APP_NAME": "Gauge",
    "PRIMARY_COLOR": "#174F84"
  }
}
